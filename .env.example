# .env.example — safe local defaults, no real secrets.
# Copy to .env and fill in real values. Never commit .env.
# Adding a variable requires a SPEC edit approved by the human (SPEC section 10).

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000

# ── Databases ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/nivaran?replicaSet=rs0
POSTGRES_OWNER_URL=postgresql://nivaran_owner:nivaran_owner_pass@postgres:5432/nivaran
POSTGRES_APP_URL=postgresql://nivaran_app:nivaran_app_pass@postgres:5432/nivaran
REDIS_URL=redis://redis:6379

# ── Object storage (MinIO locally) ───────────────────────────────────────────
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_ENDPOINT_PUBLIC=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nivaran
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

# ── SMTP (Mailpit locally) ───────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@nivaran.local

# ── AI ───────────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_MS=2000
LLM_PROVIDER=disabled
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
