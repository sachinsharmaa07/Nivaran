# Nivaran Production Environment Example
# SPEC.md Section 10 variables + DOMAIN
# DO NOT COMMIT REAL SECRETS. Generate .env.prod with: node scripts/gen-secrets.mjs

# Domain & Web Configuration
ENV_FILE=.env.prod.example
DOMAIN=civicpulse.duckdns.org
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=https://civicpulse.duckdns.org
API_BASE_URL=https://civicpulse.duckdns.org/api/v1

# Databases & Cache (Internal Docker network URLs)
POSTGRES_PASSWORD=
POSTGRES_OWNER_URL=postgresql://nivaran_owner:@postgres:5432/nivaran
POSTGRES_APP_URL=postgresql://nivaran_app:@postgres:5432/nivaran
MONGO_URI=mongodb://mongo:27017/nivaran?replicaSet=rs0
REDIS_URL=redis://redis:6379

# Object Storage (S3 / Local volume)
S3_ENDPOINT_INTERNAL=
S3_ENDPOINT_PUBLIC=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Authentication Tokens
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

# Email / Notifications (External SMTP or SES)
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=noreply@example.com

# AI Services
AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_MS=4000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://civicpulse.duckdns.org/api/v1/auth/google/callback
